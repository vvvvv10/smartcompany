# 部署凭据模板 —— 复制成 .env 后填写，.env 已被 .gitignore 排除，不入库。
#   cp deploy/.env.example deploy/.env
#
# 这些值同时被 deploy/docker-compose.yml 以 ${VAR} 引用，所以两边必须一致；
# 其中 JWT_SECRET 泄露等于任何人都能自己签发令牌。

# 中间件账号（测试环境，端口仅绑定 127.0.0.1，公网不可达）
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# 必须与 gateway / user-center 两侧保持一致，长度 ≥ 32 字节
JWT_SECRET=
JWT_ISSUER=example-auth

# Nacos 地址
NACOS_ADDR=127.0.0.1:8848

# ---- 仅本机脚本用，不参与 compose ----
# 服务器 SSH（root 口令）。也可用 export DEPLOY_PASSWORD=... 临时给。
# DEPLOY_HOST=workbench.example.com
# DEPLOY_USER=root
# DEPLOY_PORT=22
# DEPLOY_PASSWORD=
